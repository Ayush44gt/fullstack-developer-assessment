# Every variable is optional; these are the defaults used locally.
# DJANGO_SECRET_KEY=change-me          # unset = ephemeral random key (fine for local use)
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# DJANGO_DB_NAME=db.sqlite3
# ENABLE_SILK=1                        # defaults to DJANGO_DEBUG
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_VISIBILITY_TIMEOUT=3600
# EMAIL_PROVIDER=notifications.providers.SimulatedEmailProvider
# EMAIL_CLAIM_TTL_S=90
